generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  passwordHash            String
  name                    String
  role                    UserRole
  isActive                Boolean              @default(true)
  companyId               String?
  storeId                 String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  company                 Company?             @relation(fields: [companyId], references: [id])
  store                   Store?               @relation(fields: [storeId], references: [id])
  accountStatementsIssued AccountStatement[]   @relation("AccountStatementIssuer")
  purchaseOriginPhoneId   String?
  purchaseOriginPhone     PurchaseOriginPhone? @relation(fields: [purchaseOriginPhoneId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([storeId])
  @@index([purchaseOriginPhoneId])
}

model Company {
  id                   String                @id @default(cuid())
  name                 String
  taxId                String                @unique
  email                String
  phone                String
  address              String?
  isActive             Boolean               @default(true)
  billingFrequency     BillingFrequency      @default(DAILY)
  commissionRate       Float                 @default(0.05)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  invoices             Invoice[]
  stores               Store[]
  users                User[]
  authorizedPhones     AuthorizedPhone[]
  wallet               Wallet?
  productPrices        CompanyProductPrice[]
  productCosts         ProductCost[]
  productRates         CompanyProductRate[]
  accountStatements    AccountStatement[]
  purchaseOriginPhones PurchaseOriginPhone[]
}

model Wallet {
  id                String              @id @default(cuid())
  companyId         String              @unique
  currency          String              @default("COP")
  balance           Float               @default(0) // negativo = deuda de la compañía
  creditLimit       Float? // null = sin límite (enforcement en fase futura)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  company           Company             @relation(fields: [companyId], references: [id])
  transactions      WalletTransaction[]
  accountStatements AccountStatement[]
}

model WalletTransaction {
  id                   String                  @id @default(cuid())
  walletId             String
  type                 WalletTransactionType
  status               WalletTransactionStatus @default(CONFIRMED)
  method               WalletRechargeMethod? // solo aplica a RECHARGE; hoy siempre MANUAL
  amount               Float // positivo, en moneda de la wallet; type define la dirección
  balanceAfter         Float? // null si PENDING (no afectó el balance)
  originalAmount       Float? // monto origen (ej. USD) para trazabilidad
  originalCurrency     String?
  exchangeRate         Float? // tasa aplicada; null si PENDING sin tasa configurada
  description          String?
  externalReference    String? // # de transferencia bancaria en recargas manuales
  gatewayTransactionId String? // lo llenará la integración PSE/tarjeta futura
  createdById          String? // userId que originó el movimiento
  cardActivationId     String?                 @unique
  codePurchaseId       String?                 @unique
  createdAt            DateTime                @default(now())
  occurredAt           DateTime                @default(now())
  occurredSequence     Int                     @default(0)
  wallet               Wallet                  @relation(fields: [walletId], references: [id])
  accountStatementLine AccountStatementLine?

  @@index([walletId, createdAt])
  @@index([walletId, occurredAt, occurredSequence, id])
  @@index([status])
}

model AccountStatement {
  id                 String                 @id @default(cuid())
  statementNumber    String                 @unique
  sequenceYear       Int
  sequenceNumber     Int
  companyId          String
  walletId           String
  issuedById         String
  currency           String
  periodStart        DateTime
  periodEnd          DateTime
  openingBalance     Decimal                @db.Decimal(18, 2)
  consumptions       Decimal                @db.Decimal(18, 2)
  recharges          Decimal                @db.Decimal(18, 2)
  refunds            Decimal                @db.Decimal(18, 2)
  adjustments        Decimal                @db.Decimal(18, 2)
  closingBalance     Decimal                @db.Decimal(18, 2)
  totalPending       Decimal                @db.Decimal(18, 2)
  creditBalance      Decimal                @db.Decimal(18, 2)
  issuerSnapshot     Json
  customerSnapshot   Json
  previewFingerprint String
  issuedAt           DateTime               @default(now())
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  wallet             Wallet                 @relation(fields: [walletId], references: [id], onDelete: Restrict)
  issuedBy           User                   @relation("AccountStatementIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  lines              AccountStatementLine[]

  @@unique([sequenceYear, sequenceNumber])
  @@index([companyId, issuedAt])
  @@index([walletId, periodEnd])
  @@index([issuedById])
}

model AccountStatementLine {
  id                  String                @id @default(cuid())
  accountStatementId  String
  walletTransactionId String                @unique
  position            Int
  occurredAt          DateTime
  type                WalletTransactionType
  description         String
  productDetail       String?
  quantity            Int?
  unitPrice           Decimal?              @db.Decimal(18, 2)
  debit               Decimal               @db.Decimal(18, 2)
  credit              Decimal               @db.Decimal(18, 2)
  balanceAfter        Decimal               @db.Decimal(18, 2)
  accountStatement    AccountStatement      @relation(fields: [accountStatementId], references: [id], onDelete: Restrict)
  walletTransaction   WalletTransaction     @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@unique([accountStatementId, position])
  @@index([accountStatementId, occurredAt])
}

enum WalletTransactionType {
  OPENING_BALANCE
  RECHARGE
  CONSUMPTION
  ADJUSTMENT
  REFUND
}

enum WalletTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum WalletRechargeMethod {
  MANUAL
  PSE
  CREDIT_CARD
}

model Store {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  address              String
  phone                String
  isActive             Boolean               @default(true)
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  authorizedPhones     AuthorizedPhone[]
  cards                Card[]
  activations          CardActivation[]
  InvoiceItem          InvoiceItem[]
  company              Company               @relation(fields: [companyId], references: [id])
  users                User[]
  purchaseOriginPhones PurchaseOriginPhone[]

  @@index([companyId])
}

/// A commercial-origin number. It deliberately does not authorize QR/card
/// activation; AuthorizedPhone owns that separate security decision.
model PurchaseOriginPhone {
  id        String         @id @default(cuid())
  companyId String
  storeId   String?
  phone     String
  label     String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  users     User[]
  purchases CodePurchase[]

  @@unique([companyId, phone])
  @@index([storeId])
}

model AuthorizedPhone {
  id        String   @id @default(cuid())
  phone     String
  companyId String
  storeId   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([phone, companyId, storeId])
  @@index([companyId])
  @@index([storeId])
}

model Product {
  id               String                @id @default(cuid())
  name             String
  sku              String                @unique
  brand            String
  category         String?
  imageUrl         String?
  isActive         Boolean               @default(true)
  isGiftCard       Boolean               @default(false)
  minAmount        Float?
  maxAmount        Float?
  devDiemProductId String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  cards            Card[]
  keys             Key[]
  denominations    ProductDenomination[]
  companyPrices    CompanyProductPrice[]
  costs            ProductCost[]
  companyRates     CompanyProductRate[]
}

// Tasa comercial vigente de una compañía para un producto denominado en USD.
// Es un único valor mutable: no representa un historial de precios.
model CompanyProductRate {
  id            String   @id @default(cuid())
  companyId     String
  productId     String
  rateCopPerUsd Float
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
  @@index([productId])
}

model ProductDenomination {
  id               String                @id @default(cuid())
  amount           Float
  currency         String                @default("USD")
  devDiemProductId String?               @unique
  productId        String
  createdAt        DateTime              @default(now())
  cards            Card[]
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyPrices    CompanyProductPrice[]
  codePurchases    CodePurchase[]
  costs            ProductCost[]

  @@unique([productId, amount])
  @@index([productId])
}

// Costo que la plataforma cobra a las compañías por producto/denominación —
// es lo que se debita de la wallet. companyId null = costo global (default);
// con companyId = tarifa negociada de esa compañía (en la moneda de su wallet).
// Resolución al debitar: override compañía → global → valor nominal denominación.
model ProductCost {
  id             String               @id @default(cuid())
  companyId      String? // null = costo global (default para todas)
  productId      String
  denominationId String?
  cost           Float
  currency       String               @default("COP")
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  denomination   ProductDenomination? @relation(fields: [denominationId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId, denominationId])
  @@index([productId])
  @@index([companyId])
}

// Precio de venta al cliente final que cada compañía configura por producto/
// denominación. Distinto del costo mayorista (denominación en USD) que se
// debita de la wallet — este precio es operativo para la compañía (su margen).
model CompanyProductPrice {
  id             String               @id @default(cuid())
  companyId      String
  productId      String
  denominationId String? // null = producto con denominación única / sin denominaciones
  salePrice      Float
  currency       String               @default("COP")
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  denomination   ProductDenomination? @relation(fields: [denominationId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId, denominationId])
  @@index([companyId])
  @@index([productId])
}

model CardBatch {
  id           String   @id @default(cuid())
  code         String   @unique
  description  String?
  manufacturer String?
  currency     String   @default("COP")
  totalCards   Int
  totalCost    Float
  producedAt   DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cards        Card[]
}

model Key {
  id            String        @id @default(cuid())
  code          String        @unique
  productId     String
  isVerified    Boolean       @default(false)
  transactionId String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  status        KeyStatus     @default(AVAILABLE)
  purchaseId    String?
  card          Card?
  product       Product       @relation(fields: [productId], references: [id])
  purchase      CodePurchase? @relation(fields: [purchaseId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([purchaseId])
}

model CodePurchase {
  id                    String               @id @default(cuid())
  companyId             String
  storeId               String?
  userId                String
  productId             String
  denominationId        String?
  count                 Int
  totalAmount           Float
  currency              String               @default("USD")
  status                String               @default("PENDING") // PENDING, AWAITING_STOCK, FINALIZING, COMPLETED, ACTION_REQUIRED, FAILED
  idempotencyKey        String               @unique
  diemRequestId         String?              @unique
  fulfillmentStatus     String?
  deliveredCodes        Json?
  lastError             String?
  attempts              Int                  @default(0)
  nextRetryAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  occurredAt            DateTime             @default(now())
  occurredSequence      Int                  @default(0)
  purchaseOriginPhoneId String?
  originLabelSnapshot   String?
  sourceAmount          Float?
  sourceCurrency        String?
  appliedExchangeRate   Float?
  billingUnitAmount     Float?
  denomination          ProductDenomination? @relation(fields: [denominationId], references: [id])
  purchaseOriginPhone   PurchaseOriginPhone? @relation(fields: [purchaseOriginPhoneId], references: [id], onDelete: SetNull)

  keys Key[]

  @@index([companyId])
  @@index([storeId])
  @@index([userId])
  @@index([createdAt])
  @@index([occurredAt, occurredSequence, id])
  @@index([purchaseOriginPhoneId])
  @@index([denominationId])
  @@index([status, nextRetryAt])
}

enum KeyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Card {
  id                    String               @id @default(cuid())
  uuid                  String               @unique
  qrData                String
  productId             String
  denominationId        String?
  customAmount          Float?
  storeId               String
  isActivated           Boolean              @default(false)
  isRedeemed            Boolean              @default(false)
  activatedAt           DateTime?
  redeemedAt            DateTime?
  scanCount             Int                  @default(0)
  maxScans              Int                  @default(5)
  activationLock        Boolean              @default(false)
  activationLockBy      String?
  activationLockAt      DateTime?
  version               Int                  @default(0)
  activationAttempts    Int                  @default(0)
  lastActivationAttempt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  batchId               String?
  fabricationUnitCost   Float?
  keyId                 String?              @unique
  batch                 CardBatch?           @relation(fields: [batchId], references: [id])
  denomination          ProductDenomination? @relation(fields: [denominationId], references: [id])
  key                   Key?                 @relation(fields: [keyId], references: [id])
  product               Product              @relation(fields: [productId], references: [id])
  store                 Store                @relation(fields: [storeId], references: [id])
  activation            CardActivation?
  activationJobs        ActivationJob[]
  activationAttemptLogs ActivationAttempt[]
  invoiceItems          InvoiceItem[]
  scanLogs              ScanLog[]

  @@index([storeId])
  @@index([productId])
  @@index([isActivated])
  @@index([uuid])
  @@index([batchId])
  @@index([keyId])
  @@index([activationLock])
  @@index([isActivated, storeId, productId])
}

model CardActivation {
  id                    String                  @id @default(cuid())
  cardId                String                  @unique
  storeId               String
  activatedBy           String
  activatedAt           DateTime                @default(now())
  matrixResponse        Json?
  activationAmount      Float
  billingStatus         ActivationBillingStatus @default(PENDING)
  commissionAmount      Float?
  commissionRateApplied Float?
  grossProfit           Float?
  invoiceId             String?
  otherCosts            Float?
  commercialAmount      Float?
  commercialCurrency    String?
  sourceAmount          Float?
  sourceCurrency        String?
  appliedExchangeRate   Float?
  card                  Card                    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  invoice               Invoice?                @relation(fields: [invoiceId], references: [id])
  store                 Store                   @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([activatedAt])
  @@index([billingStatus])
  @@index([invoiceId])
}

model ScanLog {
  id         String   @id @default(cuid())
  cardId     String
  wasSuccess Boolean
  reason     String?
  ipAddress  String?
  userAgent  String?
  scannedAt  DateTime @default(now())
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([scannedAt])
  @@index([wasSuccess])
}

model Invoice {
  id               String           @id @default(cuid())
  invoiceNumber    String           @unique
  companyId        String
  periodStart      DateTime
  periodEnd        DateTime
  totalSales       Float
  commissionRate   Float
  commissionAmount Float
  totalAmount      Float
  status           InvoiceStatus    @default(PENDING)
  paidAt           DateTime?
  pdfUrl           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  exchangeRate     Float?
  CardActivation   CardActivation[]
  company          Company          @relation(fields: [companyId], references: [id])
  items            InvoiceItem[]

  @@index([companyId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  storeId     String?
  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id])
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  store       Store?   @relation(fields: [storeId], references: [id])

  @@index([invoiceId])
  @@index([storeId])
  @@index([cardId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  SYSTEM_ADMIN
  OWNER
  GENERAL_ADMIN
  ADMIN
  OPERATOR
}

enum BillingFrequency {
  DAILY
  THREE_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ActivationBillingStatus {
  PENDING
  INVOICED
  PAID
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model ActivationAttempt {
  id            String   @id @default(cuid())
  cardId        String
  userId        String
  storeId       String
  companyId     String?
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  deviceId      String?
  createdAt     DateTime @default(now())
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId, createdAt])
  @@index([storeId])
}

model RateLimitLog {
  id          String   @id @default(cuid())
  userId      String
  storeId     String?
  action      String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([userId, action, windowStart])
  @@index([userId, action, windowStart])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  userId       String
  companyId    String?
  storeId      String?
  entityType   String?
  entityId     String?
  ipAddress    String?
  userAgent    String?
  deviceId     String?
  before       Json?
  after        Json?
  details      Json?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum SalePriceCorrectionStatus {
  PENDING
  REMOTE_APPLIED
  COMPLETED
  FAILED
}

model SalePriceCorrection {
  id                  String                    @id @default(cuid())
  idempotencyKey      String                    @unique
  companyId           String
  targetType          String
  targetId            String
  walletTransactionId String
  diemRequestId       String
  status              SalePriceCorrectionStatus @default(PENDING)
  fingerprint         String
  reason              String
  oldRate             Float
  newRate             Float
  oldTotal            Float
  newTotal            Float
  actorId             String
  lastError           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  completedAt         DateTime?

  @@index([companyId, createdAt])
  @@index([targetType, targetId])
  @@index([status, updatedAt])
}

model ActivationJob {
  id                  String    @id @default(cuid())
  cardId              String
  userId              String?
  storeId             String?
  status              String    @default("PENDING") // PENDING, PROCESSING, AWAITING_STOCK, FINALIZING, COMPLETED, ACTION_REQUIRED, FAILED
  attempts            Int       @default(0)
  lastError           String?
  idempotencyKey      String    @unique
  diemRequestId       String?   @unique
  fulfillmentStatus   String?
  commercialAmount    Float?
  commercialCurrency  String?
  sourceAmount        Float?
  sourceCurrency      String?
  appliedExchangeRate Float?
  deliveredCodes      Json?
  nextRetryAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  card Card @relation(fields: [cardId], references: [id])

  @@index([status, attempts])
  @@index([cardId])
  @@index([createdAt])
  @@index([status, nextRetryAt])
}
